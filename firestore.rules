rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Auction listings — deliberately world-readable (to any signed-in
    // member) with every field included, since nothing about a listing —
    // price, condition, bid history — is meant to be gated behind a code.
    // Three separate shapes of "allow update" cover the three legitimate
    // ways this doc changes:
    //   (a) the owner editing their own listing (blocked client-side once a
    //       bid lands — see listings.js — but the doc itself doesn't need a
    //       rules-level lock, since the owner already fully controls it);
    //   (b) any signed-in member bumping the view counter only, when they
    //       open the detail view (see item.js);
    //   (c) any signed-in non-owner placing a higher bid: only the bidding
    //       fields may change, the new bid must exceed the current price,
    //       the bidder must be naming themselves, bidCount must advance by
    //       exactly one, and endTime may only move forward (the anti-snipe
    //       extension), never back.
    match /items/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']) ||
        (
          resource.data.ownerUid != request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['currentBid', 'currentBidderUid', 'currentBidderName', 'bidCount', 'everBidUids', 'endTime']
          ) &&
          request.resource.data.currentBidderUid == request.auth.uid &&
          request.resource.data.currentBid >
            (resource.data.currentBid != null ? resource.data.currentBid : resource.data.startingPrice) &&
          request.resource.data.bidCount == (resource.data.bidCount != null ? resource.data.bidCount : 0) + 1 &&
          request.resource.data.endTime >= resource.data.endTime
        )
      );
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    // The public bid history for an item — append-only from the client.
    // Anyone signed in can read it (that transparency is the point of the
    // platform); a bid can only ever be logged as yourself, and never edited
    // or removed once placed.
    match /items/{itemId}/bids/{bidId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.bidderUid == request.auth.uid;
      allow update, delete: if false;
    }

    match /threads/{threadId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create, update: if request.auth != null
        && request.auth.uid in request.resource.data.participants;
    }
    match /threads/{threadId}/messages/{messageId} {
      allow read: if request.auth != null && threadId.matches('.*' + request.auth.uid + '.*');
      allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
    }

    match /reports/{reportId} {
      allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false; // reports are write-only from the client; review them in the console
    }

    // An item detail view's quick-feedback chips. Anyone signed in can leave
    // one, but only as themselves — same create-only shape as reports.
    // Unlike reports, read access is open to any signed-in member (not just
    // the owner): feedback is meant as public, lightweight social proof on
    // the listing itself, plus it powers the seller's live notification
    // listener (notifications.js) and the summary on their own My Listings
    // page (listings.js).
    match /feedback/{feedbackId} {
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow read: if request.auth != null;
      allow update, delete: if false; // immutable once sent, same as reports
    }
  }
}
